<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:padding="@dimen/photo_detail_indicator_padding"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/indicator1"
            android:alpha="0.5"
            android:background="@drawable/shape_circle_primary"
            android:layout_width="@dimen/photo_detail_indicator_size"
            android:layout_height="@dimen/photo_detail_indicator_size"/>

        <View
            android:id="@+id/indicator2"
            android:layout_marginTop="@dimen/photo_detail_indicator_padding"
            android:alpha="0.5"
            android:background="@drawable/shape_circle_primary"
            android:layout_width="@dimen/photo_detail_indicator_size"
            android:layout_height="@dimen/photo_detail_indicator_size"/>


        <View
            android:id="@+id/indicator3"
            android:layout_marginTop="@dimen/photo_detail_indicator_padding"
            android:background="@drawable/shape_circle_primary"
            android:layout_width="@dimen/photo_detail_indicator_size"
            android:layout_height="@dimen/photo_detail_indicator_size"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>