<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/homeRedditImageView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/banner_height"
        android:scaleType="fitStart"
        android:src="@drawable/ic_reddit"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/titleTextView"
        android:padding="@dimen/home_body_padding"
        android:background="@drawable/shape_rounded_left_primary"
        app:layout_constraintTop_toBottomOf="@id/homeRedditImageView"
        app:layout_constraintRight_toRightOf="parent"
        android:textColor="@color/white"
        android:textSize="@dimen/right_label_textSize"
        android:text="@string/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/homeInfoTextView"
        android:padding="@dimen/home_body_padding"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintLeft_toLeftOf="parent"
        android:drawablePadding="@dimen/home_body_padding"
        android:drawableStart="@drawable/ic_menu_image"
        android:textColor="@color/black"
        android:text="@string/home_info_photos"
        android:textSize="@dimen/home_body_text_textSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/settingsInfoTextView"
        android:padding="@dimen/home_body_padding"
        android:drawablePadding="@dimen/home_body_padding"
        app:layout_constraintTop_toBottomOf="@id/homeInfoTextView"
        app:layout_constraintLeft_toLeftOf="parent"
        android:drawableStart="@drawable/ic_menu_settings"
        android:textColor="@color/black"
        android:textSize="@dimen/home_body_text_textSize"
        android:text="@string/home_info_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>



</androidx.constraintlayout.widget.ConstraintLayout>