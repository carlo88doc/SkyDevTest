<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/detailPhotoDescriptionTitleText"
        android:background="@color/colorAccent"
        android:padding="@dimen/photo_detail_title_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="@dimen/photo_detail_title_textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoAuthorLabel"
        android:padding="@dimen/photo_detail_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoDescriptionTitleText"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textSize="@dimen/photo_image_author_textSize"
        android:textColor="@color/colorAccent"
        android:text="@string/author"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoAuthorText"
        android:padding="@dimen/photo_detail_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoDescriptionTitleText"
        app:layout_constraintLeft_toRightOf="@id/detailPhotoAuthorLabel"
        app:layout_constraintRight_toLeftOf="@id/guideline"
        android:textSize="@dimen/photo_image_author_textSize"
        android:textColor="@color/grey"
        tools:text="Carlo"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoDateLabel"
        android:padding="@dimen/photo_detail_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoDescriptionTitleText"
        app:layout_constraintRight_toLeftOf="@id/detailPhotoDateText"
        android:textSize="@dimen/photo_image_author_textSize"
        android:textColor="@color/colorAccent"
        android:text="@string/created_date"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoDateText"
        android:padding="@dimen/photo_detail_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoDescriptionTitleText"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="@dimen/photo_image_author_textSize"
        android:textColor="@color/grey"
        tools:text="24/07/2020"
        android:layout_width="0dp"
        android:textStyle="bold"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoDescriptionLabel"
        android:padding="@dimen/photo_detail_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoAuthorLabel"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textSize="@dimen/photo_image_author_textSize"
        android:textColor="@color/colorAccent"
        android:text="@string/description"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailPhotoDescriptionText"
        android:paddingLeft="@dimen/photo_detail_title_padding"
        android:paddingRight="@dimen/photo_detail_title_padding"
        android:paddingBottom="@dimen/photo_detail_title_padding"
        app:layout_constraintTop_toBottomOf="@id/detailPhotoDescriptionLabel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/photo_detail_description_textSize"
        android:textColor="@color/grey"
        android:layout_width="0dp"
        android:layout_height="0dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>